# Copy to .env and fill in. Never commit .env.

# PostgreSQL superuser (used only by scripts/setup_db.py to create roles and the database)
PG_HOST=localhost
PG_PORT=5432
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=

# Application database and roles created by setup_db.py
PG_DATABASE=copo
PG_OWNER_PASSWORD=
PG_API_PASSWORD=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=copo

# API
JWT_SECRET=

# Password for the demo logins created by datagen (hod, coordinator, fac01.., student USNs)
DEMO_PASSWORD=
