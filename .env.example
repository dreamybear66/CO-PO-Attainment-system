# Copy to .env and fill in. Never commit .env.

# PostgreSQL superuser (used only by scripts/setup_db.py to create roles and the database)
PG_HOST=localhost
PG_PORT=5432
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=

# Application database and roles created by setup_db.py
PG_DATABASE=copo
PG_OWNER_PASSWORD=
PG_API_PASSWORD=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=copo

# API
JWT_SECRET=
# Key for the anonymous survey respondent ids (HMAC). Any long random string; keep it stable.
SURVEY_HASH_SECRET=

# Answer-sheet OCR. Path to tesseract.exe if it is not on PATH (Windows default shown).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Google Forms surveys (phase 8). From your Google Cloud project's OAuth client (README: Google
# Forms setup). GOOGLE_TOKEN_KEY encrypts stored Google tokens; make one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
GOOGLE_TOKEN_KEY=
# Survey responses must use an email address of this domain.
COLLEGE_EMAIL_DOMAIN=rvce.edu.in

# Password for the demo logins created by datagen (hod, coordinator, fac01.., student USNs)
DEMO_PASSWORD=
